{
  "name": "@andes/andes-fhir-server",
  "version": "1.0.0",
  "description": "FHIR Facade Server implementing for ANDES",
  "main": "dist/index.js",
  "repository": "https://github.com/andes/andes-fhir-server",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "npm run tsc && npm run node",
    "node": "cross-env NODE_ENV=development nodemon dist/index.js",
    "prod": "cross-env NODE_ENV=production node dist/index.js",
    "tsc": "tsc",
    "tsc:w": "tsc -w",
    "test": "npm run test:lint && npm run test:jest",
    "test:lint": "eslint \"src/**/*.ts\"",
    "test:jest": "jest --forceExit"
  },
  "dependencies": {
    "@andes/fhir": "^1.13.0-beta",
    "@asymmetrik/fhir-json-schema-validator": "^0.9.8",
    "@asymmetrik/node-fhir-server-core": "^2.1.3",
    "@asymmetrik/sof-scope-checker": "^1.0.2",
    "dotenv": "^16.4.5",
    "got": "^13.0.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.46",
    "mongodb": "^6.10.0",
    "object-hash": "^3.0.0",
    "passport-http-bearer": "^1.0.1",
    "shiro-trie": "^0.4.9"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "elastic-apm-node": "^4.5.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.2"
  },
  "private": false
}